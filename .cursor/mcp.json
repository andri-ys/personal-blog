{
  "mcpServers": {
    "grep_app": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.grep.app"]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "dotenv-cli",
        "-e", ".env",
        "--",
        "npx", "-y", "mcp-remote",
        "https://mcp.context7.com/mcp",
        "--header",
        "CONTEXT7_API_KEY:${CONTEXT7_API_KEY}"
      ]
    }
  }
}
