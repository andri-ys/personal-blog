---
import { t, tBlogHeaderTitle } from '../lib/translations';
import type { Locale } from '../lib/translations';

export interface Props {
  lang: Locale;
  title?: string;
  /** Current path (e.g. Astro.url.pathname) so the language link keeps the same page */
  currentPath?: string;
  /** Current URL (e.g. Astro.url) so language switch keeps search/hash */
  currentUrl?: URL;
}

const { lang, title = tBlogHeaderTitle(lang), currentPath, currentUrl } = Astro.props;

function swapLocaleInPath(pathname: string, locale: Locale): string {
  return pathname.replace(/^\/(id|en)(\/|$)/, `/${locale}$2`);
}

const basePath = currentUrl?.pathname ?? currentPath ?? "";
const suffix = `${currentUrl?.search ?? ""}${currentUrl?.hash ?? ""}`;
const idHref = basePath ? swapLocaleInPath(basePath, "id") + suffix : "/id/";
const enHref = basePath ? swapLocaleInPath(basePath, "en") + suffix : "/en/";
const searchHref = `/${lang}/search`;
const baseLinkClass =
  "inline-flex h-9 items-center justify-center rounded px-2 text-gray-500 hover:bg-gray-200 hover:text-gray-900 focus:outline focus:ring-2 focus:ring-gray-400 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100 dark:focus:ring-gray-500";
const activeLinkClass = "theme-btn-selected";
---

<header class="mb-8 border-b border-gray-200 pb-4 dark:border-gray-700">
  <div class="flex items-start justify-between gap-3">
    <h1 class="m-0 text-lg font-semibold sm:text-xl">
      <a href="/" class="no-underline text-inherit hover:underline">{title}</a>
    </h1>
    <div class="flex items-center gap-2">
      <button
        type="button"
        class="inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-gray-200 hover:text-gray-900 focus:outline focus:ring-2 focus:ring-gray-400 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100 dark:focus:ring-gray-500 sm:hidden"
        aria-label={t("searchLabel", lang) + " & menu"}
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h16" />
          <path d="M4 12h16" />
          <path d="M4 18h16" />
        </svg>
      </button>
      <nav class="hidden items-center gap-3 sm:flex">
        <a
          href={searchHref}
          class={baseLinkClass}
          title={t("searchLabel", lang)}
          aria-label={t("searchLabel", lang)}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </a>
        <span class="mx-2 inline-block h-6 w-px bg-gray-200 dark:bg-gray-700" aria-hidden="true"></span>
        <span class="inline-flex items-center gap-1" aria-label="Language" role="group">
          <a
            href={idHref}
            data-locale-base={idHref}
            title="Bahasa Indonesia"
            aria-label="Bahasa Indonesia"
            aria-current={lang === "id" ? "page" : undefined}
            class:list={[baseLinkClass, lang === "id" && activeLinkClass]}
          >
            ID
          </a>
          <a
            href={enHref}
            data-locale-base={enHref}
            title="English"
            aria-label="English"
            aria-current={lang === "en" ? "page" : undefined}
            class:list={[baseLinkClass, lang === "en" && activeLinkClass]}
          >
            EN
          </a>
        </span>
        <span class="mx-2 inline-block h-6 w-px bg-gray-200 dark:bg-gray-700" aria-hidden="true"></span>
        <span class="inline-flex items-center gap-1" aria-label="Theme" role="group">
          <button
            type="button"
            data-theme="dark"
            aria-pressed="false"
            class="theme-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-gray-200 hover:text-gray-900 focus:outline focus:ring-2 focus:ring-gray-400 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100 dark:focus:ring-gray-500"
            title={t("themeDark", lang)}
          >
            <span class="sr-only">{t("themeDark", lang)}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <button
            type="button"
            data-theme="light"
            aria-pressed="false"
            class="theme-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-gray-200 hover:text-gray-900 focus:outline focus:ring-2 focus:ring-gray-400 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100 dark:focus:ring-gray-500"
            title={t("themeLight", lang)}
          >
            <span class="sr-only">{t("themeLight", lang)}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          </button>
        </span>
      </nav>
    </div>
  </div>

  <nav
    class="mt-3 hidden w-full flex flex-wrap items-center justify-center gap-3 sm:hidden"
    aria-label="Mobile menu"
    data-mobile-menu
  >
    <a
      href={searchHref}
      class={baseLinkClass}
      title={t("searchLabel", lang)}
      aria-label={t("searchLabel", lang)}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
    </a>
    <span class="mx-2 inline-block h-6 w-px bg-gray-200 dark:bg-gray-700" aria-hidden="true"></span>
    <span class="inline-flex items-center gap-1" aria-label="Language" role="group">
      <a
        href={idHref}
        data-locale-base={idHref}
        title="Bahasa Indonesia"
        aria-label="Bahasa Indonesia"
        aria-current={lang === "id" ? "page" : undefined}
        class:list={[baseLinkClass, lang === "id" && activeLinkClass]}
      >
        ID
      </a>
      <a
        href={enHref}
        data-locale-base={enHref}
        title="English"
        aria-label="English"
        aria-current={lang === "en" ? "page" : undefined}
        class:list={[baseLinkClass, lang === "en" && activeLinkClass]}
      >
        EN
      </a>
    </span>
    <span class="mx-2 inline-block h-6 w-px bg-gray-200 dark:bg-gray-700" aria-hidden="true"></span>
    <span class="inline-flex items-center gap-1" aria-label="Theme" role="group">
      <button
        type="button"
        data-theme="dark"
        aria-pressed="false"
        class="theme-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-gray-200 hover:text-gray-900 focus:outline focus:ring-2 focus:ring-gray-400 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100 dark:focus:ring-gray-500"
        title={t("themeDark", lang)}
      >
        <span class="sr-only">{t("themeDark", lang)}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button
        type="button"
        data-theme="light"
        aria-pressed="false"
        class="theme-btn inline-flex h-9 w-9 items-center justify-center rounded text-gray-500 hover:bg-gray-200 hover:text-gray-900 focus:outline focus:ring-2 focus:ring-gray-400 dark:text-gray-400 dark:hover:bg-gray-700 dark:hover:text-gray-100 dark:focus:ring-gray-500"
        title={t("themeLight", lang)}
      >
        <span class="sr-only">{t("themeLight", lang)}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      </button>
    </span>
  </nav>
</header>
<script>
  function applyTheme(theme: string) {
    document.documentElement.classList.toggle('dark', theme === 'dark');
  }
  function setThemeSelection(theme: string | null) {
    const current = (theme === 'dark' || theme === 'light' ? theme : 'dark');
    document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((btn) => {
      const isSelected = btn.getAttribute('data-theme') === current;
      btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
      btn.classList.toggle('theme-btn-selected', isSelected);
    });
  }
  document.querySelectorAll<HTMLButtonElement>('[data-theme]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const theme = btn.getAttribute('data-theme') || 'dark';
      localStorage.setItem('theme', theme);
      applyTheme(theme);
      setThemeSelection(theme);

      const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
      const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
      if (mobileToggle && mobileMenu && mobileToggle.offsetParent !== null) {
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
      }
    });
  });
  let stored = localStorage.getItem('theme');
  if (stored && stored !== 'dark' && stored !== 'light') {
    stored = 'dark';
    localStorage.setItem('theme', 'dark');
    applyTheme('dark');
  }
  setThemeSelection(stored);

  const mobileToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      const expanded = mobileToggle.getAttribute('aria-expanded') === 'true';
      const next = !expanded;
      mobileToggle.setAttribute('aria-expanded', next ? 'true' : 'false');
      mobileMenu.classList.toggle('hidden', !next);
    });

    mobileMenu.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
      link.addEventListener('click', () => {
        mobileToggle.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.add('hidden');
      });
    });
  }

  // Keep query string/hash when switching locale on static pages (e.g. /search?q=...).
  const qs = window.location.search || "";
  const hash = window.location.hash || "";
  document.querySelectorAll<HTMLAnchorElement>("[data-locale-base]").forEach((a) => {
    const base = a.dataset.localeBase || a.getAttribute("href") || "";
    // Avoid double-appending if base already contains a query/hash.
    if (base.includes("?") || base.includes("#")) return;
    a.href = base + qs + hash;
  });
</script>
