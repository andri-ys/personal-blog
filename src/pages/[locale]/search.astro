---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Pagination from "../../components/Pagination.astro";
import type { Locale } from "../../lib/translations";
import { t, tPageOf } from "../../lib/translations";

const LOCALES: Locale[] = ["en", "id"];

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "id" } }];
}

const { locale } = Astro.params as { locale: string };
if (!LOCALES.includes(locale as Locale)) return Astro.redirect("/id/");
const lang = locale as Locale;
---

<BaseLayout title={t("searchTitle", lang)} lang={lang} description={t("searchDescription", lang)}>
  <Header lang={lang} title="Blog" currentUrl={Astro.url} />

  <div class="mb-6">
    <h2 class="m-0 text-lg font-semibold">{t("searchTitle", lang)}</h2>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
      {t("searchHint", lang)}
    </p>
  </div>

  <form class="mb-6 flex gap-2" action={`/${lang}/search`} method="get" role="search">
    <label class="sr-only" for="search-q">{t("searchLabel", lang)}</label>
    <input
      id="search-q"
      name="q"
      placeholder={t("searchPlaceholder", lang)}
      autocomplete="off"
      autofocus
      class="h-10 w-full rounded-md border border-gray-300 bg-white px-3 text-sm text-gray-900 placeholder:text-gray-400 focus:outline focus:ring-2 focus:ring-gray-400 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100 dark:placeholder:text-gray-500 dark:focus:ring-gray-500"
    />
    <button
      type="submit"
      class="inline-flex h-10 items-center justify-center rounded-md border border-gray-300 bg-gray-100 px-4 text-sm font-medium text-gray-900 hover:bg-gray-200 focus:outline focus:ring-2 focus:ring-gray-400 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100 dark:hover:bg-gray-700 dark:focus:ring-gray-500"
    >
      {t("searchButton", lang)}
    </button>
  </form>

  <div id="search-status" class="mb-3 text-sm text-gray-600 dark:text-gray-400"></div>
  <ol id="search-results" class="list-none space-y-4 p-0"></ol>
  <div id="search-pagination" class="hidden">
    <Pagination>
      <button
        slot="prev"
        type="button"
        id="search-prev"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-300 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100"
      >
        <span class="sr-only">{t("previous", lang)}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 18l-6-6 6-6" />
        </svg>
      </button>

      <button
        type="button"
        id="page-picker"
        data-lang={lang}
        data-current="1"
        data-total="1"
        class="inline-flex h-9 items-center justify-center rounded-md border border-gray-200 px-3 text-center text-xs font-medium uppercase tracking-wide text-gray-500 hover:border-gray-400 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:border-gray-500 dark:hover:bg-gray-800"
      >
        {tPageOf(1, 1, lang)}
      </button>

      <button
        slot="next"
        type="button"
        id="search-next"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-300 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100"
      >
        <span class="sr-only">{t("next", lang)}</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>
    </Pagination>
  </div>

  <script is:inline define:vars={{ lang, searchIndexUnavailable: t("searchIndexUnavailable", lang) }}>
    const statusEl = document.getElementById("search-status");
    const resultsEl = document.getElementById("search-results");
    /** @type {HTMLInputElement | null} */
    const inputEl = document.getElementById("search-q");
    /** @type {HTMLDivElement | null} */
    const paginationEl = document.getElementById("search-pagination");
    /** @type {HTMLButtonElement | null} */
    const prevBtn = document.getElementById("search-prev");
    /** @type {HTMLButtonElement | null} */
    const nextBtn = document.getElementById("search-next");
    /** @type {HTMLButtonElement | null} */
    const pickerBtn = document.getElementById("page-picker");

    const PAGE_SIZE = 10;

    function setStatus(text) {
      if (statusEl) statusEl.textContent = text;
    }

    function setPageInUrl(page) {
      const url = new URL(window.location.href);
      if (page <= 1) url.searchParams.delete("page");
      else url.searchParams.set("page", String(page));
      window.history.pushState({}, "", url);
    }

    function escapeHtml(s) {
      return String(s)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    async function run() {
      if (!resultsEl) return;
      const params = new URLSearchParams(window.location.search);
      const query = (params.get("q") || "").trim();
      const pageRaw = params.get("page") || "1";
      const currentPage = Math.max(1, parseInt(pageRaw, 10) || 1);
      if (inputEl) inputEl.value = query;

      resultsEl.innerHTML = "";
      if (paginationEl) paginationEl.classList.add("hidden");

      if (!query) {
        setStatus(lang === "id" ? "Ketik kata kunci untuk mulai mencari." : "Type a query to start searching.");
        return;
      }

      setStatus(lang === "id" ? "Mencari…" : "Searching…");

      let pagefind;
      try {
        pagefind = await import("/pagefind/pagefind.js");
      } catch (e) {
        setStatus(searchIndexUnavailable);
        return;
      }

      if (!pagefind || typeof pagefind.search !== "function") {
        setStatus(searchIndexUnavailable);
        return;
      }

      let res;
      try {
        res = await pagefind.search(query, { filters: { locale: lang } });
      } catch (e) {
        setStatus(searchIndexUnavailable);
        return;
      }
      const count = res?.results?.length ?? 0;

      if (!count) {
        setStatus(lang === "id" ? "Tidak ada hasil." : "No results.");
        return;
      }

      const totalPages = Math.max(1, Math.ceil(count / PAGE_SIZE));
      const page = Math.min(currentPage, totalPages);

      // Normalize URL if page overflows.
      if (page !== currentPage) setPageInUrl(page);

      setStatus(
        lang === "id"
          ? `${count} hasil — halaman ${page} dari ${totalPages}.`
          : `${count} results — page ${page} of ${totalPages}.`,
      );

      const start = (page - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const items = await Promise.all(res.results.slice(start, end).map((r) => r.data()));
      for (const item of items) {
        const title = item.meta?.title || item.meta?.page_title || item.url;
        const description = item.meta?.description || "";
        const li = document.createElement("li");
        li.className = "border-b border-gray-200 pb-4 dark:border-gray-700";
        li.innerHTML = `
          <a class="text-inherit no-underline hover:underline" href="${escapeHtml(item.url)}">
            <strong>${escapeHtml(title)}</strong>
          </a>
          ${description ? `<p class="mt-1 text-sm text-gray-600 dark:text-gray-400">${escapeHtml(description)}</p>` : ""}
          ${item.excerpt ? `<p class="mt-2 text-sm text-gray-700 dark:text-gray-300">${item.excerpt}</p>` : ""}
        `;
        resultsEl.appendChild(li);
      }

      if (!paginationEl || !prevBtn || !nextBtn || !pickerBtn) return;
      if (totalPages <= 1) return;

      paginationEl.classList.remove("hidden");

      // Update picker label + datasets so behavior matches index.
      pickerBtn.dataset.lang = lang;
      pickerBtn.dataset.current = String(page);
      pickerBtn.dataset.total = String(totalPages);
      pickerBtn.textContent = lang === "id" ? `Halaman ${page} dari ${totalPages}` : `Page ${page} of ${totalPages}`;

      // Match index: hide prev/next when not available.
      prevBtn.hidden = page <= 1;
      nextBtn.hidden = page >= totalPages;

      prevBtn.onclick = () => {
        const nextPage = Math.max(1, page - 1);
        setPageInUrl(nextPage);
        run();
        window.scrollTo({ top: 0, behavior: "smooth" });
      };

      nextBtn.onclick = () => {
        const nextPage = Math.min(totalPages, page + 1);
        setPageInUrl(nextPage);
        run();
        window.scrollTo({ top: 0, behavior: "smooth" });
      };

      pickerBtn.onclick = () => {
        const total = Number(pickerBtn.dataset.total || "1");
        const current = Number(pickerBtn.dataset.current || "1");
        const label =
          lang === "id"
            ? `Ke halaman (1-${total})`
            : `Go to page (1-${total})`;
        const input = window.prompt(label, String(current));
        if (!input) return;
        const n = Number(input);
        if (!Number.isFinite(n) || n < 1 || n > total) return;
        setPageInUrl(n);
        run();
        window.scrollTo({ top: 0, behavior: "smooth" });
      };
    }

    run();
    window.addEventListener("popstate", () => run());
  </script>
</BaseLayout>

