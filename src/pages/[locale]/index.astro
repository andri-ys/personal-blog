---
import { getCollection } from "astro:content";
import { parseBlogEntryId } from "../../content.config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import CoverImage from "../../components/CoverImage.astro";
import Pagination from "../../components/Pagination.astro";
import { getPageSlice, getTotalPages } from "../../lib/pagination";
import { getReadingTimeMinutes, formatReadingTime } from "../../lib/reading-time";
import { t, tPageOf } from "../../lib/translations";
import type { Locale } from "../../lib/translations";

const LOCALES: Locale[] = ["en", "id"];

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "id" } }];
}

const { locale } = Astro.params as { locale: string };
if (!LOCALES.includes(locale as Locale)) return Astro.redirect("/id/");
const lang = locale as Locale;
const otherLocale = lang === "en" ? "id" : "en";

const allEntries = await getCollection("blog");
const sorted = allEntries
  .filter((e) => e.id.endsWith(`--${lang}`))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const currentPage: number = 1;
const entries = getPageSlice(sorted, currentPage);
const totalPages = getTotalPages(sorted.length);

const dateLocale = lang === "en" ? "en-US" : "id-ID";
const title = lang === "en" ? "Astro Blog" : "Blog Astro";
---

<BaseLayout title={title} lang={lang}>
  <Header lang={lang} title="Blog" currentUrl={Astro.url} />
  <ul class="list-none space-y-8 p-0">
    {entries.map((entry) => {
      const parsed = parseBlogEntryId(entry.id);
      if (!parsed) return null;
      const { slug } = parsed;
      const cover = entry.data.coverImage;
      return (
        <li id={`post-${slug}`} class="border-b border-gray-200 pb-6 dark:border-gray-700">
          <a href={`/${lang}/blog/${slug}${currentPage > 1 ? `?from=${currentPage}` : ""}`} class="text-inherit no-underline hover:underline">
            {cover && (
              <CoverImage
                src={cover}
                alt={entry.data.title}
                width={800}
                height={400}
                className="mb-2 block h-auto w-full"
              />
            )}
            <strong>{entry.data.title}</strong>
          </a>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            <time datetime={entry.data.publishDate.toISOString()}>
              {entry.data.publishDate.toLocaleDateString(dateLocale, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            {" · "}
            <span>{formatReadingTime(getReadingTimeMinutes(entry.body ?? ""), lang)}</span>
            {" · "}
            <a href={`/${otherLocale}/blog/${slug}${currentPage > 1 ? `?from=${currentPage}` : ""}`} class="text-gray-600 hover:underline dark:text-gray-400 dark:hover:text-gray-200">{otherLocale === "en" ? "EN" : "ID"}</a>
          </p>
          <p class="mt-1 text-gray-600 dark:text-gray-400">{entry.data.description}</p>
        </li>
      );
    })}
  </ul>
  <Pagination show={totalPages > 1}>
    <Fragment slot="prev">
      {currentPage > 1 && (
        <a
          href={currentPage === 2 ? `/${lang}/` : `/${lang}/page/${currentPage - 1}`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-300 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100"
        >
          <span class="sr-only">{t("previous", lang)}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </a>
      )}
    </Fragment>
    <button
      type="button"
      id="page-picker"
      data-lang={lang}
      data-current={currentPage}
      data-total={totalPages}
      class="inline-flex h-9 items-center justify-center rounded-md border border-gray-200 px-3 text-center text-xs font-medium uppercase tracking-wide text-gray-500 hover:border-gray-400 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-400 dark:hover:border-gray-500 dark:hover:bg-gray-800"
    >
      {tPageOf(currentPage, totalPages, lang)}
    </button>
    <Fragment slot="next">
      {currentPage < totalPages && (
        <a
          href={`/${lang}/page/${currentPage + 1}`}
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-300 text-gray-600 hover:bg-gray-100 hover:text-gray-900 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-gray-100"
        >
          <span class="sr-only">{t("next", lang)}</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </a>
      )}
    </Fragment>
  </Pagination>
  <script>
    const picker = document.getElementById("page-picker") as HTMLButtonElement | null;
    if (picker) {
      picker.addEventListener("click", () => {
        const total = Number(picker.dataset.total || "1");
        const lang = (picker.dataset.lang || "en") as "en" | "id";
        const current = Number(picker.dataset.current || "1");
        const label =
          lang === "id"
            ? `Ke halaman (1-${total})`
            : `Go to page (1-${total})`;
        const input = window.prompt(label, String(current));
        if (!input) return;
        const n = Number(input);
        if (!Number.isFinite(n) || n < 1 || n > total) return;
        const target = n === 1 ? `/${lang}/` : `/${lang}/page/${n}`;
        window.location.href = target;
      });
    }
  </script>
</BaseLayout>
