---
import { getCollection } from "astro:content";
import { parseBlogEntryId } from "../../content.config";
import { getPageSlice, getTotalPages } from "../../lib/pagination";
import { getReadingTimeMinutes, formatReadingTime } from "../../lib/reading-time";
import { t, tPageOf } from "../../lib/translations";
import type { Locale } from "../../lib/translations";
import Header from "../../components/Header.astro";

const LOCALES: Locale[] = ["en", "id"];

export async function getStaticPaths() {
  return [{ params: { locale: "en" } }, { params: { locale: "id" } }];
}

const { locale } = Astro.params as { locale: string };
if (!LOCALES.includes(locale as Locale)) return Astro.redirect("/id/");
const lang = locale as Locale;
const otherLocale = lang === "en" ? "id" : "en";

const allEntries = await getCollection("blog");
const sorted = allEntries
  .filter((e) => e.id.endsWith(`--${lang}`))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const currentPage: number = 1;
const entries = getPageSlice(sorted, currentPage);
const totalPages = getTotalPages(sorted.length);

const dateLocale = lang === "en" ? "en-US" : "id-ID";
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{lang === "en" ? "Astro Blog" : "Blog Astro"}</title>
	</head>
	<body>
		<Header lang={lang} title="Blog" />
		<ul style="list-style: none; padding: 0;">
			{entries.map((entry) => {
				const parsed = parseBlogEntryId(entry.id);
				if (!parsed) return null;
				const { slug } = parsed;
				const cover = entry.data.coverImage;
				return (
					<li id={`post-${slug}`} style="margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem;">
						<a href={`/${lang}/blog/${slug}${currentPage > 1 ? `?from=${currentPage}` : ""}`}>
							{cover && (
								<img
									src={cover}
									alt=""
									width="800"
									height="400"
									style="width: 100%; max-width: 600px; height: auto; display: block; margin-bottom: 0.5rem;"
									loading="lazy"
								/>
							)}
							<strong>{entry.data.title}</strong>
						</a>
						<p>
							<time datetime={entry.data.publishDate.toISOString()}>
								{entry.data.publishDate.toLocaleDateString(dateLocale, {
									year: "numeric",
									month: "short",
									day: "numeric",
								})}
							</time>
							{" · "}
							<span>{formatReadingTime(getReadingTimeMinutes(entry.body ?? ""), lang)}</span>
							{" · "}
							<a href={`/${otherLocale}/blog/${slug}${currentPage > 1 ? `?from=${currentPage}` : ""}`}>{otherLocale === "en" ? "EN" : "ID"}</a>
						</p>
						<p>{entry.data.description}</p>
					</li>
				);
			})}
		</ul>
		{totalPages > 1 && (
			<nav>
				{currentPage > 1 && (
					<a href={currentPage === 2 ? `/${lang}/` : `/${lang}/page/${currentPage - 1}`}>
						{t("previous", lang)}
					</a>
				)}
				{" "}
				<span>{tPageOf(currentPage, totalPages, lang)}</span>
				{currentPage < totalPages && (
					<>
						{" "}
						<a href={`/${lang}/page/${currentPage + 1}`}>{t("next", lang)}</a>
					</>
				)}
			</nav>
		)}
	</body>
</html>
