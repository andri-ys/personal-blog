---
import { getCollection } from "astro:content";
import { parseBlogEntryId } from "../../../content.config";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import { getPageSlice, getTotalPages } from "../../../lib/pagination";
import { getReadingTimeMinutes, formatReadingTime } from "../../../lib/reading-time";
import { t, tPageOf } from "../../../lib/translations";
import type { Locale } from "../../../lib/translations";

const LOCALES: Locale[] = ["en", "id"];

export async function getStaticPaths() {
  const allEntries = await getCollection("blog");
  const totalPagesEn = getTotalPages(
    allEntries.filter((e) => e.id.endsWith("--en")).length
  );
  const totalPagesId = getTotalPages(
    allEntries.filter((e) => e.id.endsWith("--id")).length
  );
  const paths: { params: { locale: string; page: string } }[] = [];
  for (const loc of ["en", "id"] as const) {
    const totalPages = loc === "en" ? totalPagesEn : totalPagesId;
    if (totalPages <= 1) continue;
    for (let i = 2; i <= totalPages; i++) {
      paths.push({ params: { locale: loc, page: String(i) } });
    }
  }
  return paths;
}

const { locale, page } = Astro.params as { locale: string; page: string };
if (!LOCALES.includes(locale as Locale)) return Astro.redirect("/id/");
const lang = locale as Locale;
const otherLocale = lang === "en" ? "id" : "en";

const currentPage = page ? parseInt(page, 10) : 2;
if (currentPage < 2) return Astro.redirect(`/${lang}/`);

const allEntries = await getCollection("blog");
const sorted = allEntries
  .filter((e) => e.id.endsWith(`--${lang}`))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const totalPages = getTotalPages(sorted.length);
if (currentPage > totalPages) return Astro.redirect(`/${lang}/`);

const entries = getPageSlice(sorted, currentPage);
const dateLocale = lang === "en" ? "en-US" : "id-ID";
const title = lang === "en" ? `Blog — Page ${currentPage}` : `Blog — Halaman ${currentPage}`;
---

<BaseLayout title={title} lang={lang}>
  <Header lang={lang} title="Blog" currentPath={Astro.url.pathname} />
  <ul class="list-none space-y-8 p-0">
    {entries.map((entry) => {
      const parsed = parseBlogEntryId(entry.id);
      if (!parsed) return null;
      const { slug } = parsed;
      const cover = entry.data.coverImage;
      return (
        <li id={`post-${slug}`} class="border-b border-gray-200 pb-6 dark:border-gray-700">
          <a href={`/${lang}/blog/${slug}?from=${currentPage}`} class="text-inherit no-underline hover:underline">
            {cover && (
              <img
                src={cover}
                alt=""
                width="800"
                height="400"
                class="mb-2 block h-auto w-full"
                loading="lazy"
              />
            )}
            <strong>{entry.data.title}</strong>
          </a>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            <time datetime={entry.data.publishDate.toISOString()}>
              {entry.data.publishDate.toLocaleDateString(dateLocale, {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
            {" · "}
            <span>{formatReadingTime(getReadingTimeMinutes(entry.body ?? ""), lang)}</span>
            {" · "}
            <a href={`/${otherLocale}/blog/${slug}?from=${currentPage}`} class="text-gray-600 hover:underline dark:text-gray-400 dark:hover:text-gray-200">{otherLocale === "en" ? "EN" : "ID"}</a>
          </p>
          <p class="mt-1 text-gray-600 dark:text-gray-400">{entry.data.description}</p>
        </li>
      );
    })}
  </ul>
  <nav class="mt-8 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-stretch gap-3 text-sm text-gray-600 dark:text-gray-400">
    <div>
      <a
        href={currentPage === 2 ? `/${lang}/` : `/${lang}/page/${currentPage - 1}`}
        class="flex max-w-[10rem] flex-col rounded border border-gray-200 px-3 py-2 text-left hover:border-gray-400 hover:bg-gray-50 dark:border-gray-700 dark:hover:border-gray-500 dark:hover:bg-gray-800"
      >
        <span class="text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
          {t("previous", lang)}
        </span>
      </a>
    </div>
    <span class="self-center px-3 py-2 text-center text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">
      {tPageOf(currentPage, totalPages, lang)}
    </span>
    <div class="text-right">
      {currentPage < totalPages && (
        <a
          href={`/${lang}/page/${currentPage + 1}`}
          class="ml-auto flex max-w-[10rem] flex-col items-end rounded border border-gray-200 px-3 py-2 text-right hover:border-gray-400 hover:bg-gray-50 dark:border-gray-700 dark:hover:border-gray-500 dark:hover:bg-gray-800"
        >
          <span class="text-xs font-medium uppercase tracking-wide text-gray-400 dark:text-gray-500">
            {t("next", lang)}
          </span>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>
